# ─────────────────────────────────────────────────────────────
# AI Health Checker — Example Environment Configuration
# ─────────────────────────────────────────────────────────────

# MongoDB Connection
# Local MongoDB: mongodb://127.0.0.1:27017
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/ai_health_checker?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=ai_health_checker

# JWT Authentication
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI / Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here

# Server Configuration
APP_NAME=AI Medical Symptom Assistant
APP_VERSION=1.0.0
DEBUG=True
PORT=8005
