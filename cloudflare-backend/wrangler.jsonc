{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-health-checker-api",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai_health_checker",
      "database_id": "9fe3c262-a0ee-49de-8616-b9d670f941b3"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APP_NAME": "AI Medical Symptom Assistant"
  }
}
